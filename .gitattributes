# Match the LF policy enforced by prek, including Windows launch scripts.
* text=auto eol=lf

# Artwork and external binary formats must not receive text conversions.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.glb binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.zstd binary

# Versioned exported field data; keep the upstream ownership notice readable.
/field-2027/** filter=lfs diff=lfs merge=lfs -text
/field-2027/CAD-NOTICE.md -filter -diff -merge text eol=lf
/field-rmul-2027-3v3/** filter=lfs diff=lfs merge=lfs -text
/field-rmul-2027-3v3/CAD-NOTICE.md -filter -diff -merge text eol=lf
/field-rmul-2027-1v1/** filter=lfs diff=lfs merge=lfs -text
/field-rmul-2027-1v1/CAD-NOTICE.md -filter -diff -merge text eol=lf
